{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.HealthChecks": "None",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "None"
    }
  },
  "AllowedHosts": "*",
  "ApplicationName": "Ciir.Indexer.Api",
  "Observability": {
    "OpenTelemetry": {
      "UseTracingExporter": "Console",
      "UseMetricsExporter": "Console",
      "UseLogExporter": "DotNotUse"
    }
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=ciir_indexer;Username=postgres;Password=postgres"
  },
  "Keycloak": {
    "Enabled": false,
    "Authority": "",
    "Audience": "",
    "ClientId": "",
    "MetadataAddress": "",
    "RequireHttpsMetadata": true
  },
  "Embeddings": {
    "Provider": "Ollama",
    "Model": "bge-m3",
    "Dimensions": 1024,
    "BaseUrl": "http://localhost:11434",
    "BatchSize": 32,
    "TimeoutSeconds": 60,
    "MaxRetries": 3,
    "Normalize": true
  },
  "Indexing": {
    "DocumentBatchSize": 500,
    "RelationBatchSize": 500
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UseSsl": false,
    "BucketName": "ciir-uploads"
  },
  "Uploads": {
    "MaxCiirFileSizeBytes": 209715200,
    "StuckProcessingTimeoutMinutes": 30,
    "PollingIntervalSeconds": 60,
    "MaxRetryCount": 3,
    "MaxConcurrentUploads": 3
  }
}
